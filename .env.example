# Copy to .env on the VPS. Never commit the real file.

# Shared-secret bearer that maps to the `dev` role (needed for /confirm).
# Generate with: openssl rand -hex 24
AUTH_DEV_TOKEN=

# Optional: JWKS auth (takes precedence over AUTH_DEV_TOKEN when set).
# AUTH_JWKS_URL=
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# AUTH_DEV_ROLES=devteam,admin

# Host docker group id (sandbox-runner needs it to use docker.sock).
# getent group docker | cut -d: -f3
DOCKER_GID=988

# Optional token so only agent-api can call sandbox-runner POST /run.
SANDBOX_RUNNER_TOKEN=

# Public origins allowed to call the API from a browser.
CORS_ORIGINS=https://kovi.kovanica.online,https://kovanica.online,https://www.kovanica.online

# Read-only node RPC used by query_node_api.
KOVANICA_NODE_URL=https://explorer.kovanica.online

# Optional hosted LLM (overrides local Ollama/vLLM when set).
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=
# AGENT_MODEL=qwen2.5-coder

# Apply → draft PR is fail-closed. Leave unset / 0 on the public VPS.
AGENT_GIT_APPLY_ENABLED=
AGENT_GIT_DRY_RUN=1

# Telegram Bot Gateway (optional)
# Get token from @BotFather, revoke if ever exposed
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (empty = allow all)
TELEGRAM_ALLOWED_USERS=8462734378
# Default session ID for Telegram conversations
KOVANICA_SESSION=telegram-main

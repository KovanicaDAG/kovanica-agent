"""
FastAPI entrypoint. Routes:
  GET  /         - Kovanica chat UI
  GET  /healthz  - liveness
  GET  /readyz   - dependency probe
  POST /chat     - send a message, get the agent's response (or a
                    "pending_confirmation" if it proposed a diff)
  POST /confirm  - approve or reject a pending diff, resumes the graph

Role is derived from auth, not from the request body. The `Authorization`
header is verified with real JWT auth (see auth.py): JWKS mode when
AUTH_JWKS_URL is set, dev-token mode otherwise. Only `dev` may confirm.

/confirm -> apply.gate: on approval, staged proposals (patchstore) are turned
into a throwaway git branch + draft PR by apply.py (fail-closed behind
AGENT_GIT_APPLY_ENABLED == "1"). On rejection or absence of proposals the
proposal store is cleared/resumed without touching any git repo.
"""

import json
import os
import time
from collections import defaultdict, deque
from dataclasses import dataclass
from functools import wraps
from pathlib import Path
from typing import Callable, Type, Optional, List, Literal, Any

import requests
from fastapi import FastAPI, Header, HTTPException, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles
from fastapi.security import HTTPBearer, APIKeyHeader
from pydantic import BaseModel, Field, ConfigDict

from auth import verify_token
from graph import build_graph
import patchstore as _patchstore

# =============================================================================
# OpenAPI Configuration
# =============================================================================

app = FastAPI(
    title="Kovanica Engineering Agent API",
    version="1.0.0",
    description="""
## Kovanica Engineering Agent API

The Kovanica Agent is an AI-powered engineering assistant that helps developers
with code changes, reviews, and repository operations through a conversational interface.

### Features
- **Chat Interface**: Natural language interaction with the engineering agent
- **Diff Proposals**: Agent proposes code changes as unified diffs
- **Human-in-the-loop**: Changes require explicit approval before application
- **Git Integration**: Approved changes create branches and draft PRs
- **Session Management**: Conversation state persisted per session

### Authentication
The API uses JWT-based authentication with two modes:
- **JWKS Mode**: Production mode using a JWKS endpoint (set `AUTH_JWKS_URL`)
- **Dev Token Mode**: Development mode with a simple token (default)

Include the `Authorization: Bearer <token>` header in all requests.

### Rate Limiting
- Default: 30 requests per 60 seconds per IP
- Configurable via `AGENT_RATE_LIMIT` and `AGENT_RATE_WINDOW_S` environment variables

### Error Responses
All endpoints may return standard HTTP error codes:
- `400` - Bad Request (invalid input)
- `401` - Unauthorized (missing/invalid token)
- `403` - Forbidden (insufficient role)
- `429` - Too Many Requests (rate limited)
- `500` - Internal Server Error
- `503` - Service Unavailable (dependency failure)
""",
    contact={
        "name": "Kovanica Team",
        "url": "https://kovanica.online",
    },
    license_info={
        "name": "MIT",
        "url": "https://opensource.org/licenses/MIT",
    },
    openapi_tags=[
        {
            "name": "UI",
            "description": "Static UI and frontend assets",
        },
        {
            "name": "Health",
            "description": "Health and readiness checks for orchestration",
        },
        {
            "name": "Chat",
            "description": "Conversational interface with the engineering agent",
        },
        {
            "name": "Confirmation",
            "description": "Approve or reject proposed code changes",
        },
    ],
    servers=[
        {"url": "https://kovi.kovanica.online", "description": "Production server"},
        {"url": "http://localhost:8080", "description": "Local development server"},
    ],
)

# Add security schemes to OpenAPI
def custom_openapi():
    if app.openapi_schema:
        return app.openapi_schema
    from fastapi.openapi.utils import get_openapi
    openapi_schema = get_openapi(
        title=app.title,
        version=app.version,
        description=app.description,
        routes=app.routes,
        tags=app.openapi_tags,
        servers=app.servers,
    )
    openapi_schema["components"]["securitySchemes"] = {
        "BearerToken": {
            "type": "http",
            "scheme": "bearer",
            "bearerFormat": "JWT",
            "description": "JWT Bearer token. Include as: `Authorization: Bearer <token>`"
        },
        "ApiKey": {
            "type": "apiKey",
            "in": "header",
            "name": "X-API-Key",
            "description": "API Key alternative (if enabled)"
        }
    }
    # Apply security globally
    openapi_schema["security"] = [
        {"BearerToken": []},
        {"ApiKey": []}
    ]
    app.openapi_schema = openapi_schema
    return app.openapi_schema

app.openapi = custom_openapi

# Security schemes
bearer_scheme = HTTPBearer(
    scheme_name="BearerToken",
    description="JWT Bearer token. Include as: `Authorization: Bearer <token>`",
    auto_error=False,
)

api_key_scheme = APIKeyHeader(
    name="X-API-Key",
    scheme_name="ApiKey",
    description="API Key alternative (if enabled)",
    auto_error=False,
)

agent_graph = build_graph()

STATIC_DIR = Path(__file__).resolve().parent / "static"
AUDIT_LOG = Path(os.environ.get("AGENT_AUDIT_LOG", "/data/audit.jsonl"))
AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)

_CORS = [
    o.strip()
    for o in os.environ.get(
        "CORS_ORIGINS",
        "https://kovi.kovanica.online,https://kovanica.online,"
        "https://www.kovanica.online,https://explorer.kovanica.online",
    ).split(",")
    if o.strip()
]
app.add_middleware(
    CORSMiddleware,
    allow_origins=_CORS,
    allow_credentials=True,
    allow_methods=["GET", "POST", "OPTIONS"],
    allow_headers=["Authorization", "Content-Type", "X-API-Key"],
)

_RATE_WINDOW_S = int(os.environ.get("AGENT_RATE_WINDOW_S", "60") or 60)
_RATE_LIMIT = int(os.environ.get("AGENT_RATE_LIMIT", "30") or 30)
_hits: dict[str, deque[float]] = defaultdict(deque)


def _client_ip(request: Request) -> str:
    forwarded = request.headers.get("x-forwarded-for") or ""
    if forwarded:
        return forwarded.split(",")[0].strip()
    return request.client.host if request.client else "unknown"


def _rate_ok(ip: str) -> bool:
    now = time.time()
    q = _hits[ip]
    while q and now - q[0] > _RATE_WINDOW_S:
        q.popleft()
    if len(q) >= _RATE_LIMIT:
        return False
    q.append(now)
    return True


def audit(event: dict) -> None:
    event["ts"] = time.time()
    with AUDIT_LOG.open("a") as f:
        f.write(json.dumps(event) + "\n")


# =============================================================================
# Pydantic Models - Request/Response
# =============================================================================

class ChatRequest(BaseModel):
    """Request to send a message to the engineering agent."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "session_id": "abc123-def456-ghi789",
                "message": "Add a health check endpoint to the FastAPI app"
            }
        }
    )
    
    session_id: str = Field(
        ...,
        description="Unique session identifier for conversation continuity. "
                    "Generate a new UUID for each new conversation.",
        min_length=1,
        max_length=128,
        examples=["abc123-def456-ghi789", "session-2024-01-15-001"]
    )
    message: str = Field(
        ...,
        description="User message to the agent. Can be a question, task request, "
                    "or follow-up to a previous response.",
        min_length=1,
        max_length=8000,
        examples=[
            "Add a health check endpoint to the FastAPI app",
            "Review the authentication module for security issues",
            "Create a new API endpoint for user management"
        ]
    )


class ConfirmRequest(BaseModel):
    """Request to approve or reject a pending diff proposal."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "session_id": "abc123-def456-ghi789",
                "approve": True
            }
        }
    )
    
    session_id: str = Field(
        ...,
        description="Session ID from the original chat request that returned "
                    "a pending_confirmation status.",
        min_length=1,
        max_length=128,
        examples=["abc123-def456-ghi789"]
    )
    approve: bool = Field(
        ...,
        description="Whether to approve (true) or reject (false) the proposed changes. "
                    "Approval triggers git branch creation and draft PR. "
                    "Rejection discards the proposal.",
        examples=[True, False]
    )


# Response Models

class HealthResponse(BaseModel):
    """Health check response indicating service liveness."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "status": "ok",
                "name": "kovi"
            }
        }
    )
    
    status: Literal["ok"] = Field(..., description="Service status")
    name: str = Field(..., description="Service name")


class ReadyResponse(BaseModel):
    """Readiness check response with dependency status."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "status": "ok",
                "name": "kovi",
                "deps": {
                    "qdrant": "ok",
                    "llm": "ok"
                }
            }
        }
    )
    
    status: Literal["ok"] = Field(..., description="Overall readiness status")
    name: str = Field(..., description="Service name")
    deps: dict[str, str] = Field(
        ...,
        description="Dependency health status. Each key is a dependency name, "
                    "value is 'ok', 'unset', or an error description."
    )


class ChatSuccessResponse(BaseModel):
    """Successful chat response with agent reply."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "status": "ok",
                "reply": "I've added a health check endpoint at `/healthz` that returns `{\"status\": \"ok\", \"name\": \"kovi\"}`. The endpoint is now available."
            }
        }
    )
    
    status: Literal["ok"] = Field(..., description="Response status")
    reply: str = Field(..., description="Agent's response message")


class ChatPendingConfirmationResponse(BaseModel):
    """Response when agent proposes changes requiring confirmation."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "status": "pending_confirmation",
                "detail": "Agent proposed a repo change. Review and POST /confirm.",
                "messages": [
                    "I'll add a health check endpoint to the FastAPI app.",
                    "Here's the proposed change:",
                    "```diff\n+ @app.get(\"/healthz\")\n+ def healthz():\n+     return {\"status\": \"ok\", \"name\": \"kovi\"}\n```"
                ]
            }
        }
    )
    
    status: Literal["pending_confirmation"] = Field(..., description="Response status")
    detail: str = Field(..., description="Human-readable explanation of next steps")
    messages: List[str] = Field(
        ...,
        description="Recent conversation messages including the proposed diff"
    )


class ConfirmRejectedResponse(BaseModel):
    """Response when proposal is rejected."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "status": "rejected",
                "detail": "Proposal discarded (not applied).",
                "reply": "Proposal discarded."
            }
        }
    )
    
    status: Literal["rejected"] = Field(..., description="Response status")
    detail: str = Field(..., description="Explanation of the rejection")
    reply: str = Field(..., description="User-facing message")


class ConfirmApprovedNoProposalsResponse(BaseModel):
    """Response when approved but no proposals to apply."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "status": "approved",
                "reply": "No pending proposals to apply.",
                "applied": []
            }
        }
    )
    
    status: Literal["approved"] = Field(..., description="Response status")
    reply: str = Field(..., description="User-facing message")
    applied: List[str] = Field(default_factory=list, description="List of applied files (empty)")


class ConfirmAppliedResponse(BaseModel):
    """Response when proposals are successfully applied."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "status": "ok",
                "reply": "Successfully applied changes and created PR #42",
                "applied_files": ["agent/main.py"],
                "branch": "kovi/abc123-health-check",
                "pr_url": "https://github.com/org/repo/pull/42",
                "detail": "Successfully applied changes and created PR #42"
            }
        }
    )
    
    status: Literal["ok"] = Field(..., description="Response status")
    reply: str = Field(..., description="User-facing message")
    applied_files: Optional[List[str]] = Field(
        default=None,
        description="List of files that were modified"
    )
    branch: Optional[str] = Field(
        default=None,
        description="Git branch name created for the changes"
    )
    pr_url: Optional[str] = Field(
        default=None,
        description="URL to the created draft pull request"
    )
    detail: Optional[str] = Field(
        default=None,
        description="Additional details from the apply operation"
    )


class ConfirmErrorResponse(BaseModel):
    """Response when apply operation fails."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "status": "error",
                "reply": "apply-agent timed out",
                "detail": "apply-agent timed out"
            }
        }
    )
    
    status: Literal["error"] = Field(..., description="Response status")
    reply: str = Field(..., description="User-facing error message")
    detail: str = Field(..., description="Technical error details")


class ErrorResponse(BaseModel):
    """Standard error response."""
    model_config = ConfigDict(
        json_schema_extra={
            "example": {
                "detail": "message is required"
            }
        }
    )
    
    detail: str = Field(..., description="Error description")


# Union types for OpenAPI schema generation
ChatResponse = ChatSuccessResponse | ChatPendingConfirmationResponse
ConfirmResponse = (
    ConfirmRejectedResponse 
    | ConfirmApprovedNoProposalsResponse 
    | ConfirmAppliedResponse 
    | ConfirmErrorResponse
)


# =============================================================================
# Action Registry
# =============================================================================

@dataclass
class ActionSpec:
    path: str
    model: Type[BaseModel]
    handler: Callable
    summary: str = ""
    require_dev: bool = False


_ACTION_REGISTRY: dict[str, ActionSpec] = {}


def register_action(
    path: str,
    model: Type[BaseModel],
    *,
    summary: str = "",
    description: str = "",
    require_dev: bool = False,
    tags: Optional[List[str]] = None,
    responses: Optional[dict] = None,
) -> Callable:
    """Decorator that registers a POST action on ``app`` and in the registry.

    Usage::

        @register_action("/chat", ChatRequest, summary="Send a message", tags=["Chat"])
        async def chat(req: ChatRequest, request: Request,
                       authorization: str | None = Header(default=None)):
            ...
    """

    def decorator(handler: Callable) -> Callable:
        if require_dev:
            @wraps(handler)
            async def guarded(
                req,
                request: Request,
                authorization: str | None = Header(default=None),
            ):
                role = verify_token(authorization)
                if role != "dev":
                    raise HTTPException(
                        status_code=403, detail="Only dev role may call this action"
                    )
                return await handler(req, request, authorization)

            enforced_handler = guarded
        else:
            enforced_handler = handler

        # Build response model documentation
        route_kwargs = {"summary": summary or path}
        if description:
            route_kwargs["description"] = description
        if tags:
            route_kwargs["tags"] = tags
        if responses:
            route_kwargs["responses"] = responses

        app.post(path, **route_kwargs)(enforced_handler)
        _ACTION_REGISTRY[path] = ActionSpec(
            path=path,
            model=model,
            handler=enforced_handler,
            summary=summary,
            require_dev=require_dev,
        )
        return enforced_handler

    return decorator


def list_actions() -> list[ActionSpec]:
    """Return the currently registered actions, in registration order."""
    return list(_ACTION_REGISTRY.values())



# ---------------------------------------------------------------------------
# Grounding context (mirrors graph.py:_grounding_context)
# ---------------------------------------------------------------------------

def _grounding_context(question: str) -> str:
    """Always retrieve RAG context so the model does not have to emit tool calls."""
    chunks = []
    try:
        found = search_codebase(question)
        if found and found != "(code search unavailable":
            chunks.append(found[:4500])
    except Exception as exc:
        chunks.append(f"(code search unavailable: {exc.__class__.__name__})")
    try:
        found_docs = search_kovanica_docs(question)
        if found_docs and found_docs != "(skill docs search unavailable":
            chunks.append(found_docs[:3500])
    except Exception as exc:
        chunks.append(f"(skill docs search unavailable: {exc.__class__.__name__})")
    q = (question or "").lower()
    if any(h in q for h in _LIVE_HINTS):
        try:
            live = query_node_api("/api/head")
            chunks.append("Live node /api/head:\n" + str(live)[:1500])
        except Exception:
            pass
    return "\n\n".join(chunks)


# ---------------------------------------------------------------------------
# Tool call detection (for CPU 3B models that dump fake tool JSON)
# ---------------------------------------------------------------------------

_TOOL_JSON_RE = re.compile(
    r'\{\"\\s*name\"\\s*:\\s*\"(search_codebase|search_kovanica_docs|explain_concept|'
    r'query_node_api|read_file|run_cargo_command|git_diff_suggest|run_kovanica_cli)\"',
    re.IGNORECASE,
)


def strip_fake_tool_json(text: str) -> str:
    """If the model dumped fake tool-call JSON, strip it and return clean text."""
    # Remove ```json ... ``` blocks containing tool calls
    text = re.sub(r'```json\s*\{[^}]*\"name\"\s*:\s*"(?:search_codebase|search_kovanica_docs|explain_concept|query_node_api|read_file|run_cargo_command|git_diff_suggest|run_kovanica_cli)"[^}]*\}\s*```', '', text, flags=re.DOTALL)
    # Remove standalone tool-call JSON objects
    text = re.sub(r'\{"name"\s*:\s*"(?:search_codebase|search_kovanica_docs|explain_concept|query_node_api|read_file|run_cargo_command|git_diff_suggest|run_kovanica_cli)"[^}]*\}', '', text)
    return text.strip()


# ---------------------------------------------------------------------------
# Main chat loop
# ---------------------------------------------------------------------------

def chat(message: str, session_id: str = "cli-default", role: str = "dev") -> str:
    """Run one turn of the agent and return the reply text.

    The CLI chat path uses grounding (pre-fetched RAG context) + system prompt
    and lets the LLM answer directly — no tool binding. Tool execution is done
    by the user directly via `kovi search`, `kovi read`, `kovi cargo`, etc.
    This is simpler and works with any OpenAI-compatible model.
    """
    base_url, api_key, model = resolve_llm()

    if not base_url or base_url == "http://vllm:8000/v1":
        return (
            "ERROR: No LLM endpoint configured. Set one of:\n"
            "  LLM_BASE_URL=https://your-llm/v1  LLM_API_KEY=...\n"
            "  VLLM_BASE_URL=http://host:port/v1   (GPU vLLM / Ollama)\n"
            "  AGENT_MODEL=qwen2.5-coder:3b       (optional, default varies)\n"
            "Without an LLM endpoint the chat/explain commands cannot reason."
        )

    llm = ChatOpenAI(
        base_url=base_url,
        api_key=api_key,
        model=model,
        temperature=0.1,
        timeout=180,
        max_retries=1,
    )

    user_text = message
    grounding = _grounding_context(user_text) if user_text else ""

    sys = SYSTEM_PROMPT
    if grounding:
        sys += (
            "\n\n## Retrieved context (already fetched — answer from it)\n"
            "Write a direct answer in prose. Cite file paths from this context "
            "when you use them. Do NOT emit tool-call JSON.\n\n"
            + grounding
        )

    messages = [SystemMessage(content=sys), HumanMessage(content=user_text)]

    # No bind_tools — the CLI user runs tools directly. Just answer from
    # the grounding + system prompt. This avoids the "Unsupported function"
    # error from passing raw dict names to bind_tools, and works with any
    # OpenAI-compatible model (including CPU 3B models via Ollama).
    try:
        response = llm.invoke(messages)
    except Exception as exc:
        return f"ERROR: LLM call failed: {exc.__class__.__name__}: {exc}"

    text = _msg_text(response)
    text = strip_fake_tool_json(text)
    return text or "(empty response from LLM)"


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="kovi",
        description="Kovi — Kovanica engineering agent CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
examples:
  kovi chat "how is selected_parent computed in kovanica-dag"
  kovi explain mergeset
  kovi search "coinbase maturity"
  kovi read crates/kovanica-state/src/ledger.rs 100 120
  kovi cargo test -p kovanica-dag
  kovi kovanica head
  kovi kovanica balance kvnc1q...dag
  kovi cargo clippy --all-targets
  kovi diff crates/kovanica-node/src/node.rs "fix maturity" '--- a/path ...'
  kovi node /api/head
""",
    )
    sub = parser.add_subparsers(dest="command")

    # chat
    p_chat = sub.add_parser("chat", help="Send a message and get the agent's response")
    p_chat.add_argument("message", nargs="+", help="Message to the agent")
    p_chat.add_argument("--session", default="cli-default", help="Session ID")
    p_chat.add_argument("--role", choices=["dev", "user"], default="dev", help="Role (dev = full tools)")

    # explain
    p_explain = sub.add_parser("explain", help="Explain a protocol term")
    p_explain.add_argument("term", help="Term to explain (e.g. mergeset, blue_score)")

    # search
    p_search = sub.add_parser("search", help="Search the codebase")
    p_search.add_argument("query", help="Search query")

    # read
    p_read = sub.add_parser("read", help="Read a file from the repo")
    p_read.add_argument("path", help="Path relative to repo root")
    p_read.add_argument("start", nargs="?", type=int, default=1, help="Start line (1-indexed)")
    p_read.add_argument("end", nargs="?", type=int, default=None, help="End line (optional)")

    # cargo
    p_cargo = sub.add_parser("cargo", help="Run a whitelisted cargo command")
    p_cargo.add_argument("command", choices=["check", "test", "clippy", "build"], help="Cargo subcommand")
    p_cargo.add_argument("args", nargs=argparse.REMAINDER, help="Additional args (e.g. -p kovanica-dag)")

    # kovanica CLI — bind the kovanica-cli crate's binary
    p_kovanica = sub.add_parser("kovanica", help="Run the kovanica-cli binary (explorer + wallet)")
    p_kovanica.add_argument("args", nargs=argparse.REMAINDER, help="Args forwarded to `kovanica` (e.g. head, balance ADDR)")

    # diff (propose a patch)
    p_diff = sub.add_parser("diff", help="Propose a patch (does NOT apply it)")
    p_diff.add_argument("path", help="File path relative to repo root")
    p_diff.add_argument("explanation", help="Why this change is needed")
    p_diff.add_argument("patch", help="Unified diff text")

    # node
    p_node = sub.add_parser("node", help="Query the read-only node RPC")
    p_node.add_argument("endpoint", help="API endpoint (e.g. /api/head)")

    args = parser.parse_args()

    if args.command is None:
        parser.print_help()
        sys.exit(0)

    if args.command == "chat":
        message = " ".join(args.message)
        reply = chat(message, session_id=args.session, role=args.role)
        print(reply)

    elif args.command == "explain":
        reply = explain_concept(args.term)
        print(reply)

    elif args.command == "search":
        reply = search_codebase(args.query)
        print(reply)

    elif args.command == "read":
        reply = read_file(args.path, args.start, args.end)
        print(reply)

    elif args.command == "cargo":

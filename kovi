def search_codebase(query: str) -> str:
    """Semantic + keyword search over the indexed Kovanica codebase.

    Delegates to the search-agent subservice over HTTP (compose internal).
    Falls back to a grep-based search over the repo when the service is
    unreachable (less precise but still useful).
    """
    url = (_env("SEARCH_AGENT_URL") or "http://search-agent:8082").rstrip("/") + "/search/code"
    try:
        resp = requests.post(url, json={"query": query, "k_code": 8, "k_docs": 5}, timeout=20)
        resp.raise_for_status()
        body = resp.json()
        if "error" in body:
            raise RuntimeError(body["error"])
        return body.get("results", body.get("code", str(body)))
    except Exception:
        # Fallback: ripgrep-style search over the repo
        return _local_search(query)


def _local_search(query: str) -> str:
    """Fallback search using ripgrep via subprocess over the repo."""
    import subprocess
    # Try rg first
    try:
        cmd = ["rg", "-n", "--smart-case", query, str(REPO_ROOT)]
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        if result.returncode == 0 and result.stdout.strip():
            lines = result.stdout.strip().splitlines()[:30]
            return "Local search results (rg):\n" + "\n".join(lines)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    # Fallback to grep
    try:
        cmd = ["grep", "-rn", "--include=*.rs", "--include=*.md", "--include=*.toml", query, str(REPO_ROOT)]
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        if result.returncode == 0 and result.stdout.strip():
            lines = result.stdout.strip().splitlines()[:30]
            return "Local search results (grep):\n" + "\n".join(lines)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return f"(no local search tool available; cannot search for '{query})"


def search_kovanica_docs(query: str) -> str:
    """Semantic search over the Kovanica Blockchain Developer skill's reference docs."""
    url = (_env("SEARCH_AGENT_URL") or "http://search-agent:8082").rstrip("/") + "/search/docs"
    try:
        resp = requests.post(url, json={"query": query, "k_code": 5, "k_docs": 8}, timeout=20)
        resp.raise_for_status()
        body = resp.json()
        if "error" in body:
            raise RuntimeError(body["error"])
        return body.get("results", body.get("docs", str(body)))
    except Exception:
        # Fallback: search the skill references directory
        skill_refs = AGENT_DIR / "kovanica-blockchain-developer-references"
        if skill_refs.exists():
            return _local_search_in_dir(query, skill_refs)
        return f"(skill docs search unavailable — no search-agent and no local references at {skill_refs})"


def _local_search_in_dir(query: str, directory: Path) -> str:
    import subprocess
    try:
        cmd = ["rg", "-n", "--smart-case", query, str(directory)]
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        if result.returncode == 0 and result.stdout.strip():
            lines = result.stdout.strip().splitlines()[:20]
            return "Skill docs search results (local):\n" + "\n".join(lines)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return f"(cannot search skill docs locally for '{query})"


def read_file(path: str, start_line: int = 1, end_line: Optional[int] = None) -> str:
    """Read a slice of a file from the repo. Path is relative to repo root."""
    full_path = REPO_ROOT / path.lstrip("/")
    if not full_path.resolve().is_relative_to(REPO_ROOT.resolve()):
        return "ERROR: path escapes repo root"
    if not full_path.is_file():
        return f"ERROR: file not found: {path}"
    with open(full_path, "r", errors="replace") as f:
        lines = f.readlines()
    end_line = end_line or len(lines)
    return "".join(lines[start_line - 1:end_line])


def run_cargo_command(command: str, args: list[str] = []) -> str:
    """Run a whitelisted cargo command against the repo.

    Without the sandbox-runner sidecar (compose not up), runs cargo directly
    on the host against REPOS_PATH. Only check/test/clippy/build are allowed.
    Cargo's own output is streamed live to the real stdout/stderr — we only
    capture the exit code and return a short status line. This avoids both
    pipe-buffering deadlocks (cargo spawns many rustc children) and the
    "empty capture" problem observed on slow hosts.
    """
    ALLOWED = {"check", "test", "clippy", "build"}
    if command not in ALLOWED:
        return f"REJECTED: '{command}' is not whitelisted ({sorted(ALLOWED)})"

    if _sidecar_run_cargo is not None:
        result = _sidecar_run_cargo(command, list(args), repo_path=REPOS_PATH)
        # If the sidecar is unreachable, fall back to direct host execution
        if result.startswith("ERROR: cannot reach sandbox-runner"):
            pass  # fall through to direct execution below
        else:
            return result

    # Direct host execution (compose not available)
    import subprocess
    cargo_cmd = ["cargo", command] + list(args)
    proc = subprocess.run(
        cargo_cmd,
        capture_output=True,
        text=True,
        timeout=300,
        cwd=str(REPO_ROOT),
    )
    combined = (proc.stdout or "") + (proc.stderr or "")
    if proc.returncode == 0:
        display = combined.strip()
        if display:
            # Show first 8000 chars of cargo output + status
            return f"cargo {command} OK:\n{display[:8000]}"
        return f"cargo {command} OK"
    else:
        display = combined.strip()
        return f"cargo {command} FAILED (exit {proc.returncode}):\n{display[:8000]}"


def run_kovanica_cli(args: list[str]) -> str:
    """Run the kovanica-cli binary against the live explorer.

    Forwards args to `cargo run -p kovanica-cli -- <args>` (or the installed
    binary if available on PATH). Only read-only explorer commands (head, p2p,
    bootstrap, state, blocks, balance, address) are allowed; keygen and send
    require a local key file and are gated behind the same restrictions as the
    node API. Returns the binary's stdout (or stderr on failure).
    """
    if not args:
        return "REJECTED: no arguments — usage: kovi kovanica <command> [args...]"

    ALLOWED_COMMANDS = {
        "head", "p2p", "bootstrap", "state", "blocks",
        "balance", "address", "help", "--help",
    }
    first = args[0]
    if first not in ALLOWED_COMMANDS and first != "help":
        return (
            f"REJECTED: '{first}' is not an allowed kovanica command. "
            f"Allowed: {sorted(ALLOWED_COMMANDS)}. "
            f"keygen/send require a local key file and are not exposed via kovi."
        )

    # Prefer a pre-built binary on PATH or in the target dir; fall back to cargo run.
    import shutil, os
    binary = shutil.which("kovanica")
    if not binary:
        candidate = os.path.join(str(REPO_ROOT), "target", "debug", "kovanica")
        if os.path.isfile(candidate):
            binary = candidate
    if binary:
        cmd = [binary] + args
    else:
        cmd = ["cargo", "run", "-p", "kovanica-cli", "--", *args]

    import subprocess
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=60,
            cwd=str(REPO_ROOT),
        )
        combined = (proc.stdout or "") + (proc.stderr or "")
        if proc.returncode == 0:
            return combined.strip() or f"kovanica {first} OK (no output)"
        else:
            return f"kovanica {first} FAILED (exit {proc.returncode}):\n{combined.strip()[:4000]}"
    except subprocess.TimeoutExpired:
        return f"kovanica {first} TIMEOUT after 60s"
    except FileNotFoundError:
        return "ERROR: cargo not found on PATH"


def git_diff_suggest(path: str, explanation: str, patch: str) -> str:
    """Propose a patch. NEVER writes to the real repo — only stages a proposal
    for human review. Returns a note describing the proposal."""
    # In CLI mode, we just print the proposal and return a note.
    # The real apply path requires /confirm via the HTTP API.
    note = (
        "PROPOSED (not applied). This diff is staged for human review.\n"
        f"File: {path}\n"
        f"Why: {explanation}\n"
        f"--- patch ---\n{patch}\n"
        "To apply: use the HTTP /confirm endpoint with approve=true, or run "
        "`kovi apply --approve` after reviewing."
    )
    return note


def query_node_api(endpoint: str) -> str:
    """Read-only GET against the Kovanica node RPC."""
    node_url = _env("KOVANICA_NODE_URL", "https://explorer.kovanica.online")

    _BLOCKED = {"mine", "faucet", "submit", "operator"}
    _ALLOWED = {
        "/api/head", "/api/state", "/api/blocks", "/api/bootstrap",
        "/api/history", "/api/utxos", "/api/origins", "/metrics",
        "/api/fee_estimate",
    }

    normalised = endpoint.strip()
    if any(tok in normalised.lower() for tok in _BLOCKED):
        return f"REJECTED: endpoint '{normalised}' contains a blocked keyword ({_BLOCKED})"
    if normalised not in _ALLOWED:
        return f"REJECTED: endpoint '{normalised}' not in allowlist. Allowed: {sorted(_ALLOWED)}"

    url = f"{node_url.rstrip('/')}{normalised}"
    try:
        resp = requests.get(url, timeout=8)
        resp.raise_for_status()
        return resp.text[:4000]
    except requests.Timeout:
        return f"ERROR: request to {url} timed out after 8s"
    except requests.ConnectionError:
        return f"ERROR: could not connect to {url}"
    except requests.HTTPError as e:
        return f"ERROR: HTTP {e.response.status_code} from {url}: {e.response.text[:1000]}"
    except Exception as exc:
        return f"ERROR: {exc}"


def explain_concept(term: str) -> str:
    """Explain a GHOSTDAG/PHANTOM/consensus/RFC/tokenomics term."""
    code_results = search_codebase(f"definition and usage of {term}")
    doc_results = search_kovanica_docs(f"definition and usage of {term}")
    return (
        f"Below are excerpts that explain or reference **{term}**, from the "
        f"Kovanica codebase and the protocol's skill/reference docs:\n\n"
        + code_results
        + "\n\n---\n\n"
        + doc_results
    )


